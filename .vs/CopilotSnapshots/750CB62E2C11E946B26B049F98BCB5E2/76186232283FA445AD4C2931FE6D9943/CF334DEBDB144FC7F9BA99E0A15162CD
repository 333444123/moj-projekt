namespace WinFormsApp2
{
    public partial class Form1 : Form
    {
        public Form1()
        {
            InitializeComponent();
        }


        private void dateTimePicker1_ValueChanged(object sender, EventArgs e)
        {

        }

        private void button1_Click(object sender, EventArgs e)
        {
            // Sprawdź czy pola nie są puste
            if (string.IsNullOrWhiteSpace(textBox1.Text) ||
                string.IsNullOrWhiteSpace(textBox2.Text) ||
                string.IsNullOrWhiteSpace(textBox3.Text) ||
                string.IsNullOrWhiteSpace(textBox6.Text))
            {
                label9.Text = "Wypełnij wszystkie pola";
                return;
            }

            // Sprawdź długość PESEL
            if (textBox3.TextLength != 11)
            {
                label9.Text = "Pesel za krótki";
                return;
            }

            // Wyznacz płeć sprawdzając 10. znak PESELu (indeks 9)
            char genderChar = textBox3.Text[9];
            string gender = (char.IsDigit(genderChar) && ((genderChar - '0') % 2 == 1)) ? "Mężczyzna" : "Kobieta";

            label9.Text = $"Imie: {textBox1.Text}\n" +
                $"Nazwisko: {textBox2.Text}\n" +
                $"Pesel: {textBox3.Text}\n" +
                $"Płeć: {gender}\n" +
                $"Data urodzenia: {dateTimePicker1.Value.ToShortDateString()}\n" +
                $"Miasto: {textBox6.Text}";
        }
    }
}
